# ==========================================
# PERSONAL FINANCE TRACKER - ENVIRONMENT VARIABLES
# ==========================================
# CATATAN KEAMANAN:
# 1. GROQ_API_KEY HANYA boleh digunakan di backend, JANGAN PERNAH dimasukkan ke aplikasi Flutter/mobile.
# 2. JANGAN PERNAH commit file .env ke GitHub atau repositori publik.
# 3. JANGAN menuliskan token asli / credential di source code.
# 4. Buat salinan file ini dengan nama `.env` di folder backend untuk konfigurasi lokal.
# ==========================================

# Server Configuration
PORT=5000
NODE_ENV=development
APP_TIMEZONE=Asia/Jakarta

# Database Configuration (Supabase PostgreSQL)
# Gunakan connection string dari Supabase Dashboard -> Project Settings -> Database
# DATABASE_URL: Transaction Pooler connection string (Port 6543)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:6543/postgres?pgbouncer=true
# DIRECT_URL: Direct connection string for Prisma migrations (Port 5432)
DIRECT_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Authentication
JWT_SECRET=your_super_secret_jwt_key_min_32_characters_long_random_string

# Groq AI Integration (Server-side Only)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b

# Telegram Bot Integration
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ
TELEGRAM_WEBHOOK_SECRET=your_telegram_webhook_secret_token

